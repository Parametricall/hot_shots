{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "VERCEL", "VERCEL_ENV", "VERCEL_GIT_COMMIT_SHA", "STORYBOOK"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_*",
        "CLERK_*",
        "ADMIN_USER_ID"
      ],
      "outputs": [".output/**", ".vercel/output/**", ".tanstack/**", "src/routeTree.gen.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:ci": {
      "outputs": []
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    }
  }
}
