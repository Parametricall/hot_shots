# Copy to .env and fill in. Never commit .env.
#
# Every VITE_* variable is inlined into the browser bundle, not just the ones the
# app reads (Clerk's env lookup pulls in the whole set). Never give a secret a
# VITE_ prefix.

# Supabase. The URL is not a secret; SUPABASE_URL overrides it on the server.
VITE_SUPABASE_URL=
# SUPABASE_URL=
# Server-only secret: an sb_secret_… key, or the legacy service_role JWT. It
# bypasses RLS, which denies the publishable key every row (docs/adr/0002).
# Locally, `npx supabase status` prints it.
SUPABASE_SECRET_KEY=

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# Dev-only quick-login buttons on /sign-in (n = 1..10). Use test-instance
# accounts only: as VITE_* variables these end up in any bundle built with them.
# VITE_DEV_USER_1_LABEL=
# VITE_DEV_USER_1_EMAIL=
# VITE_DEV_USER_1_PASSWORD=

# Storybook visual tests (CI reads it from a GitHub secret)
# CHROMATIC_PROJECT_TOKEN=

# VITE_DEMO=true builds the Demo (docs/adr/0004). Leave unset.
