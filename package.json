    "@tanstack/react-router-with-query": "1.130.17",
    "@tanstack/react-start": "1.168.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "srvx": "^0.11.20",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/css": "^0.14.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.33.0",
    "@eslint/json": "^0.14.0",
