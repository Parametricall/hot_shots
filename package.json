    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/devtools-vite": "^0.8.1",
    "@tanstack/query-async-storage-persister": "^5.101.2",
