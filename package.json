{
  "name": "hot-shots",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "inspect-dev": "cross-env NODE_OPTIONS=--inspect vite dev",
    "build": "tsc --noEmit && vite build",
    "start": "node .output/server/index.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ci": "vitest run --project=unit --project=component",
    "test:watch": "vitest",
    "chromatic": "chromatic"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.0.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/query-async-storage-persister": "^5.95.2",
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-query-devtools": "^5.85.0",
    "@tanstack/react-query-persist-client": "^5.95.2",
    "@tanstack/react-router": "^1.131.2",
    "@tanstack/react-router-devtools": "^1.131.2",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.131.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "effect": "^3.18.4",
    "lucide-react": "^1.7.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "srvx": "^0.11.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/css": "^0.14.0",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.33.0",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.1.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-vitest": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/eslint-plugin-query": "^5.83.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "*",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "^4.0.14",
    "@vitest/browser-playwright": "^4.0.13",
    "@vitest/coverage-v8": "^4.0.14",
    "autoprefixer": "^10.4.20",
    "chromatic": "^16.3.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.0.0",
    "globals": "^17.0.0",
    "jiti": "^2.5.1",
    "jsdom": "^28.1.0",
    "nitro": "npm:nitro-nightly",
    "playwright": "^1.54.2",
    "prettier": "^3.6.2",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.6",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.39.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.14"
  },
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*.js",
      "./*.jsx"
    ]
  }
}
