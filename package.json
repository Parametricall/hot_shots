{
  "name": "hot-shots",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.3.0",
  "overrides": {
    "@tanstack/router-core": "1.171.37",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4",
    "vite-plus": "1.2.0"
  },
  "scripts": {
    "dev": "vp dev",
    "inspect-dev": "cross-env NODE_OPTIONS=--inspect vp dev",
    "build": "tsc --noEmit && vp build",
    "start": "node .output/server/index.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test run",
    "test:ci": "vp test run --project=unit --project=component",
    "test:watch": "vp test",
    "chromatic": "chromatic",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.7.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/query-async-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "lucide-react": "^1.57.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260903-beta",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "srvx": "^0.11.22",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
