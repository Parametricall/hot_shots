{
  "name": "hot-shots-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.3.0",
  "workspaces": ["apps/*", "packages/*"],
  "overrides": {
    "@tanstack/router-core": "1.171.14"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "chromatic": "npm run chromatic --workspace apps/web"
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "turbo": "^2.5.4"
  }
}
