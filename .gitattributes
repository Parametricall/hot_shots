# LF everywhere, on every OS. This overrides each clone's core.autocrlf, which Git for
# Windows sets to true: without it, Windows checkouts get CRLF, `vp fmt` rewrites them to
# LF, and every touched file shows up as modified.
* text=auto eol=lf

# Binary: never convert, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
